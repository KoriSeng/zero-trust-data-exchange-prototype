# Zero Trust Data Exchange - Environment Variables Template
# Copy this file to .env and fill in your values
# Note: .env files are excluded from version control

# Node.js Environment
NODE_ENV=development

# AWS Configuration (for Terraform/Infrastructure)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── LocalStack Pro ──────────────────────────────────────────────────────────────
# Required to run the full local stack via docker-compose.
# Get your token at https://app.localstack.cloud/
LOCALSTACK_AUTH_TOKEN=your-localstack-auth-token-here

# ── OIDC IdP Configuration ─────────────────────────────────────────────────────
# IDP A Configuration
IDP_A_PORT=3000
IDP_A_ISSUER_URL=http://localhost:3000

# IDP B Configuration
IDP_B_PORT=3001
IDP_B_ISSUER_URL=http://localhost:3001

# Terraform/OpenTofu Configuration
# TF_VAR_environment=dev
# TF_VAR_aws_region=us-east-1
# TF_VAR_project_name=zero-trust-prototype

# Administrative Onboarding (REQ-004)
# ADMIN_VERIFICATION_ENABLED=true
# NDA_VERIFICATION_ENDPOINT=https://example.com/verify-nda

# TOFU Compliance
# TOFU_ENABLED=true

# Security Settings
# ENABLE_AUDIT_LOGGING=true
# LOG_LEVEL=info

# Platform Configuration (when implemented)
# PLATFORM_API_PORT=3002
# COGNITO_USER_POOL_ID=your-pool-id
# COGNITO_CLIENT_ID=your-client-id

# Database Configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=zero_trust_db
# DB_USER=postgres
# DB_PASSWORD=your-secure-password

# Notes:
# - Never commit real credentials to source control
# - Use AWS Secrets Manager or Parameter Store for production secrets
# - Update values based on your specific deployment requirements
# - Refer to documentation in docs/ for requirement traceability
